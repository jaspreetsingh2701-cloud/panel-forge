generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PlatformRole {
  PLATFORM_USER
  SUPER_ADMIN
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
}

enum ApplicationStatus {
  DRAFT
  ARCHIVED
}
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}
enum ResourceStatus {
  ACTIVE
  ARCHIVED
}
enum ResourceFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
  RELATION
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique @db.VarChar(320)
  platformRole    PlatformRole   @default(PLATFORM_USER) @map("platform_role")
  passwordHash    String?        @map("password_hash") @db.VarChar(255)
  displayName     String?        @map("display_name") @db.VarChar(120)
  emailVerifiedAt DateTime?      @map("email_verified_at") @db.Timestamptz(6)
  memberships     TenantMember[]
  sessions        AuthSession[]
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Tenant {
  id           String         @id @default(uuid()) @db.Uuid
  name         String         @db.VarChar(120)
  slug         String         @unique @db.VarChar(80)
  status       TenantStatus   @default(ACTIVE)
  members      TenantMember[]
  applications Application[]
  invitations WorkspaceInvitation[]
  resources   Resource[]
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenants")
}

model Application {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  name        String            @db.VarChar(80)
  description String?           @db.VarChar(240)
  template    String            @default("blank") @db.VarChar(32)
  status      ApplicationStatus @default(DRAFT)
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resources   Resource[]
  pageConfig    Json?             @map("page_config") @db.JsonB
  builderVersion Int              @default(0) @map("builder_version")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, status, updatedAt])
  @@map("applications")
}

model TenantMember {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  role      TenantRole       @default(MEMBER)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_members")
}

model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  userAgent     String?        @map("user_agent") @db.VarChar(512)
  ipAddress     String?        @map("ip_address") @db.VarChar(45)
  lastUsedAt    DateTime?      @map("last_used_at") @db.Timestamptz(6)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id               String        @id @default(uuid()) @db.Uuid
  sessionId        String        @map("session_id") @db.Uuid
  tokenHash        String        @unique @map("token_hash") @db.Char(64)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime?     @map("consumed_at") @db.Timestamptz(6)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(6)
  rotatedToTokenId String?       @unique @map("rotated_to_token_id") @db.Uuid
  session          AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rotatedTo        RefreshToken? @relation("RefreshTokenRotation", fields: [rotatedToTokenId], references: [id], onDelete: SetNull)
  rotatedFrom      RefreshToken? @relation("RefreshTokenRotation")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sessionId, expiresAt])
  @@index([consumedAt])
  @@map("refresh_tokens")
}

model WorkspaceInvitation {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  email String @db.VarChar(320)
  role TenantRole @default(MEMBER)
  status InvitationStatus @default(PENDING)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([tenantId, status, createdAt])
  @@index([tenantId, email, status])
  @@map("workspace_invitations")
}
model Resource {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  name String @db.VarChar(80)
  key String @db.VarChar(64)
  description String? @db.VarChar(240)
  status ResourceStatus @default(ACTIVE)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fields ResourceField[]
  relationSources ResourceField[] @relation("ResourceRelations")
  records DynamicRecord[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([applicationId, key])
  @@index([tenantId, applicationId, status])
  @@map("resources")
}
model ResourceField {
  id String @id @default(uuid()) @db.Uuid
  resourceId String @map("resource_id") @db.Uuid
  name String @db.VarChar(80)
  key String @db.VarChar(64)
  type ResourceFieldType
  required Boolean @default(false)
  options String[] @default([])
  relationResourceId String? @map("relation_resource_id") @db.Uuid
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  relationTarget Resource? @relation("ResourceRelations", fields: [relationResourceId], references: [id], onDelete: SetNull)
  position Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([resourceId, key])
  @@index([relationResourceId])
  @@map("resource_fields")
}
model DynamicRecord {
  id String @id @default(uuid()) @db.Uuid
  resourceId String @map("resource_id") @db.Uuid
  data Json @db.JsonB
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([resourceId, updatedAt])
  @@map("dynamic_records")
}
