# Local PostgreSQL connection used by Prisma and the NestJS API.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/panelforge"

# NestJS API port.
PORT=4000

# JWT access-token configuration.
# Replace this placeholder with a randomly generated secret.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TTL=15m
